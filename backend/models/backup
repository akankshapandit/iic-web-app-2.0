    if (!event) {
      return res.status(404).json({
        message: "Event not found",
      });
    }

    res.status(200).json({
      message:
        "Event deleted successfully!",
    });
  } catch (error) {
    console.error(
      "deleteEvent Error:",
      error
    );

    res.status(500).json({
      message:
        "Failed to delete event",
      error: error.message,
    });
  }
};