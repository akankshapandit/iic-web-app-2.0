import Event from "../models/Event.js";
import path from "path";
import fs from "fs";
import { GoogleGenerativeAI } from "@google/generative-ai";
/*
============================================================
HELPER
============================================================
*/

const genAI = new GoogleGenerativeAI(
  process.env.GEMINI_API_KEY
);

const GEMINI_MODELS = [
  process.env.GEMINI_MODEL || "gemini-2.0-flash",
  "gemini-2.5-flash-lite",
  "gemini-2.5-flash",
];

async function extractReportMetadataFromPDF(fileBuffer) {
  const prompt = `
You are an expert document extraction system.

Analyze the attached event report PDF.

Extract ONLY information that is actually present in the PDF.
Do NOT invent, guess, or generate any URLs.

The PDF may contain:
- Event/poster links
- Video links
- Photo links
- Google Drive links
- Google Photos links
- YouTube links
- Instagram/social-media links
- Other media/documentation links

Return ONLY valid JSON.

Required format:

{
  "posterLink": "",
  "videoLink": "",
  "photos": [],
  "allLinks": []
}

Rules:

1. posterLink:
   Find the URL specifically referring to the event poster.
   If no poster URL exists, return "".

2. videoLink:
   Find the URL specifically referring to the event video.
   YouTube, Google Drive, Google Photos or other video URLs are acceptable.
   If no video URL exists, return "".

3. photos:
   Extract URLs specifically referring to event photographs.
   Return them as an array of strings.
   If there are no photo URLs, return [].

4. allLinks:
   Return every actual HTTP/HTTPS URL found in the PDF.

5. Never invent a URL.

6. Do not convert ordinary text into a URL.

7. Preserve URLs exactly as they appear.

8. If multiple URLs could be poster/video/photo links, choose the ones whose surrounding text clearly identifies their purpose.

Return ONLY JSON. No markdown. No explanation.
`;

  let lastError = null;

  for (const modelName of GEMINI_MODELS) {
    try {
      const model = genAI.getGenerativeModel({
        model: modelName,
      });

      const result = await model.generateContent([
        {
          inlineData: {
            data: fileBuffer.toString("base64"),
            mimeType: "application/pdf",
          },
        },
        prompt,
      ]);

      const responseText =
        result.response.text();

      const cleanJson = responseText
        .replace(/```json/gi, "")
        .replace(/```/g, "")
        .trim();

      const parsed = JSON.parse(cleanJson);

      return {
        posterLink:
          typeof parsed.posterLink === "string"
            ? parsed.posterLink.trim()
            : "",

        videoLink:
          typeof parsed.videoLink === "string"
            ? parsed.videoLink.trim()
            : "",

        photos:
          Array.isArray(parsed.photos)
            ? parsed.photos.filter(
                (url) =>
                  typeof url === "string" &&
                  url.trim()
              )
            : [],

        allLinks:
          Array.isArray(parsed.allLinks)
            ? parsed.allLinks.filter(
                (url) =>
                  typeof url === "string" &&
                  url.trim()
              )
            : [],
      };
    } catch (error) {
      lastError = error;

      console.warn(
        `[Gemini Report Extraction] ${modelName} failed:`,
        error.message
      );
    }
  }

  throw lastError;
}


const getUploadsDirectory = () => {
  const uploadsDir = path.join(
    process.cwd(),
    "uploads",
    "events"
  );

  if (!fs.existsSync(uploadsDir)) {
    fs.mkdirSync(uploadsDir, {
      recursive: true,
    });
  }

  return uploadsDir;
};

/*
============================================================
GET ALL EVENTS
============================================================

President / Vice President will use this endpoint.

Because we return the complete MongoDB Event document,
the response includes:

reportLink
posterLink
videoLink
photos
collegePhoto
eventPhoto
*/

export const getEvents = async (
  req,
  res
) => {
  try {
    const events = await Event.find({})
      .sort({
        date: -1,
      })
      .lean();

    res.status(200).json(events);
  } catch (error) {
    console.error(
      "getEvents Error:",
      error
    );

    res.status(500).json({
      message:
        "Failed to fetch events",
      error: error.message,
    });
  }
};

