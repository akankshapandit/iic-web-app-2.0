/*
============================================================
CREATE EVENT
============================================================
*/

export const createEvent = async (
  req,
  res
) => {
  try {
    const {
      title,
      department,
      date,
      time,
      venue,
      facultyName,
      facultyEmail,
      activityType,
      category,
      level,
      isCelebration,
      message,
      status,
      reportLink,
      posterLink,
      videoLink,
      photos,
      collegePhoto,
      eventPhoto,
      source,
    } = req.body;

    if (!title || !date) {
      return res.status(400).json({
        message:
          "Title and date are required.",
      });
    }

    const event = new Event({
      title: title.trim(),

      department:
        department || "N/A",

      date: new Date(date),

      time:
        time || "10:00 AM",

      venue:
        venue || "TBD",

      facultyName:
        facultyName ||
        "Unknown",

      facultyEmail:
        facultyEmail || "",

      activityType:
        activityType || "IIC",

      category:
        category || "Workshop",

      level:
        level || "",

      isCelebration:
        Boolean(isCelebration),

      message:
        message || "",

      status:
        status || "UPCOMING",

      /*
      MEDIA
      */

      reportLink:
        reportLink || "",

      posterLink:
        posterLink || "",

      videoLink:
        videoLink || "",

      photos:
        Array.isArray(photos)
          ? photos
          : [],

      collegePhoto:
        collegePhoto || "",

      eventPhoto:
        eventPhoto || "",

      source:
        source || "CALENDAR",
    });

    await event.save();

    res.status(201).json({
      message:
        "Event created successfully!",
      event,
    });
  } catch (error) {
    console.error(
      "createEvent Error:",
      error
    );

    res.status(500).json({
      message:
        "Failed to create event",
      error: error.message,
    });
  }
};

/*
============================================================
UPDATE EVENT
============================================================

Used for status and normal event information.
*/

export const updateEvent = async (
  req,
  res
) => {
  try {
    const { id } = req.params;

    const allowedFields = [
      "title",
      "department",
      "date",
      "time",
      "venue",
      "facultyName",
      "facultyEmail",
      "activityType",
      "category",
      "level",
      "isCelebration",
      "message",
      "status",
      "reportLink",
      "posterLink",
      "videoLink",
      "photos",
      "collegePhoto",
      "eventPhoto",
      "source",
    ];

    const updateData = {};

    allowedFields.forEach(
      (field) => {
        if (
          req.body[field] !==
          undefined
        ) {
          updateData[field] =
            req.body[field];
        }
      }
    );

    const event =
      await Event.findByIdAndUpdate(
        id,
        updateData,
        {
          new: true,
          runValidators: true,
        }
      );

    if (!event) {
      return res.status(404).json({
        message: "Event not found",
      });
    }

    res.status(200).json({
      message:
        "Event updated successfully!",
      event,
    });
  } catch (error) {
    console.error(
      "updateEvent Error:",
      error
    );

    res.status(500).json({
      message:
        "Failed to update event",
      error: error.message,
    });
  }
};

/*
============================================================
UPDATE EVENT MEDIA
============================================================

This is the IMPORTANT endpoint.

It persists:

1. Report file
2. Poster file
3. Poster link
4. Video link
5. Multiple event photos

directly into MongoDB.
*/

export const updateEventMedia =
  async (req, res) => {
    try {
      const { id } =
        req.params;

      const event =
        await Event.findById(id);

      if (!event) {
        return res.status(404).json({
          message:
            "Event not found",
        });
      }

      const uploadsDir =
        getUploadsDirectory();

      /*
      ========================================================
      TEXT LINKS
      ========================================================
      */

      if (
        req.body.posterLink !==
        undefined
      ) {
        event.posterLink =
          String(
            req.body.posterLink
          ).trim();
      }

      if (
        req.body.videoLink !==
        undefined
      ) {
        event.videoLink =
          String(
            req.body.videoLink
          ).trim();
      }

      /*
      ========================================================
      FILES
      ========================================================
      */

      if (
        req.files &&
        Object.keys(req.files)
          .length > 0
      ) {
        /*
        ------------------------------------------------------
        REPORT
        ------------------------------------------------------
        */

        const reportFile = req.files.report;

if (reportFile) {
  const extension =
    path.extname(reportFile.name) || ".pdf";

  const filename =
    `report_${event._id}_${Date.now()}${extension}`;

  const filePath =
    path.join(
      uploadsDir,
      filename
    );

  // ----------------------------------------------------------
  // 1. Save the original PDF
  // ----------------------------------------------------------

  await reportFile.mv(filePath);

  event.reportLink =
    `http://localhost:3000/uploads/events/${filename}`;

  // ----------------------------------------------------------
  // 2. Extract media information FROM THE PDF
  // ----------------------------------------------------------

  try {
    console.log(
      "[Report Extraction] Analyzing uploaded PDF..."
    );

    const extracted =
      await extractReportMetadataFromPDF(
        reportFile.data
      );

    console.log(
      "[Report Extraction] Extracted:",
      extracted
    );

    // --------------------------------------------------------
    // Poster
    // --------------------------------------------------------

    if (extracted.posterLink) {
      event.posterLink =
        extracted.posterLink;
    }

    // --------------------------------------------------------
    // Video
    // --------------------------------------------------------

    if (extracted.videoLink) {
      event.videoLink =
        extracted.videoLink;
    }

    // --------------------------------------------------------
    // Photos
    // --------------------------------------------------------

    if (
      Array.isArray(extracted.photos) &&
      extracted.photos.length > 0
    ) {
      event.photos = [
        ...(event.photos || []),
        ...extracted.photos,
      ];
    }

    console.log(
      "[Report Extraction] Media saved to event."
    );

  } catch (extractionError) {

    console.error(
      "[Report Extraction] Failed:",
      extractionError.message
    );

    /*
     IMPORTANT:

     The report itself has already been saved.

     Therefore, if Gemini extraction fails,
     we don't delete the report.

     The event will still contain:
       reportLink

     while poster/video/photos remain unchanged.
    */
  }
}

        /*
        ------------------------------------------------------
        POSTER
        ------------------------------------------------------
        */

        const posterFile =
          req.files.poster;

        if (posterFile) {
          const extension =
            path.extname(
              posterFile.name
            ) || ".png";

          const filename =
            `poster_${event._id}_${Date.now()}${extension}`;

          const filePath =
            path.join(
              uploadsDir,
              filename
            );

          await posterFile.mv(
            filePath
          );

          event.posterLink =
            `http://localhost:3000/uploads/events/${filename}`;
        }

        /*
        ------------------------------------------------------
        PHOTOS
        ------------------------------------------------------
        */

        let photoFiles =
          req.files.photos;

        if (photoFiles) {
          if (
            !Array.isArray(
              photoFiles
            )
          ) {
            photoFiles = [
              photoFiles,
            ];
          }

          const photoUrls = [];

          for (
            const photo of photoFiles
          ) {
            const extension =
              path.extname(
                photo.name
              ) || ".jpg";

            const filename =
              `photo_${event._id}_${Date.now()}_${Math.random()
                .toString(36)
                .substring(
                  2,
                  8
                )}${extension}`;

            const filePath =
              path.join(
                uploadsDir,
                filename
              );

            await photo.mv(
              filePath
            );

            photoUrls.push(
              `http://localhost:3000/uploads/events/${filename}`
            );
          }

          /*
          Add new photos to existing
          photos instead of replacing them.
          */

          event.photos = [
            ...(event.photos ||
              []),
            ...photoUrls,
          ];
        }
      }

      /*
      ========================================================
      SAVE TO MONGODB
      ========================================================
      */

      await event.save();

      /*
      Return complete updated event.
      */

      res.status(200).json({
        message:
          "Event media updated successfully!",
        event,
      });
    } catch (error) {
      console.error(
        "updateEventMedia Error:",
        error
      );

      res.status(500).json({
        message:
          "Failed to update event media",
        error: error.message,
      });
    }
  };

